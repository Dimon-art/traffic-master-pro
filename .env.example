# PostgreSQL
POSTGRES_USER=trainer
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=traffic_master
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_PORT=8031
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend
FRONTEND_PORT=3003
VITE_API_URL=http://localhost:8031/api

# OpenAI
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# ИИ (DeepSeek)
# ============================================================
# [ЗАПОЛНИТЬ ПОЗЖЕ] Ключ API DeepSeek.
# Получить: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# [УЖЕ НАСТРОЕНО] Включить ИИ (true) или работать на мок-логике (false).
USE_AI=false

# Google Sheets
SHEETS_LEADS_ID=
SHEETS_HISTORY_ID=
SHEETS_CP_ARCHIVE_ID=
SHEETS_CALLS_ID=
GDRIVE_BACKUP_FOLDER_ID=

# Knowledge Base
KNOWLEDGE_BASE_PATH=/app/knowledge_base

# ============================================================
# Аутентификация (JWT)
# ============================================================
# Секретный ключ для подписи JWT.
# [ОБЯЗАТЕЛЬНО СМЕНИТЬ] Сгенерируйте:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_generate_via_python
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
